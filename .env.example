# ─────────────────────────────────────────────────────────────────────────────
# Odoo connection — copy this file to .env and fill in your values
# Read SERVER-SIDE only (Vercel function / Vite dev proxy). ODOO_USERNAME and
# ODOO_PASSWORD are never exposed to the browser; ODOO_URL is (for Odoo links).
# ─────────────────────────────────────────────────────────────────────────────

# Odoo instance URL (no trailing slash)
ODOO_URL=https://your-instance.odoo.com

# Database name — usually the subdomain
ODOO_DB=your-instance

# Login email of the Odoo user
ODOO_USERNAME=you@adage-automation.com

# API key (recommended — Odoo → Preferences → Account Security → API Keys) or password
ODOO_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft sign-in (Azure AD / Entra ID) — gates access in production.
# Skipped entirely in `npm run dev`. Public client identifiers, safe in the bundle.
# ─────────────────────────────────────────────────────────────────────────────
VITE_MICROSOFT_CLIENT_ID=your-azure-app-client-id
VITE_MICROSOFT_TENANT_ID=your-azure-tenant-id
